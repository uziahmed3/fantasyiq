# ---- Postgres ----
POSTGRES_USER=fantasyiq
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fantasyiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
PREDICTION_CACHE_TTL=3600

# ---- Backend ----
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# openssl rand -hex 32
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- ML service ----
ML_SERVICE_URL=http://ml-service:9000
ML_SERVICE_TIMEOUT_SECONDS=5
MODEL_DIR=/models
ACTIVE_MODEL_VERSION=xgboost_v1

# ---- Pipeline ----
INGEST_SEASONS=2021,2022,2023
INGEST_POSITIONS=WR,RB,TE,QB

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
