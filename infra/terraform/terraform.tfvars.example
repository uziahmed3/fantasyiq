aws_region  = "us-east-1"
environment = "prod"

# HTTPS: create an ACM cert in the same region and paste the ARN.
# Leave empty for a dev environment served over plain HTTP.
certificate_arn = ""

backend_desired_count = 2
backend_max_count     = 8
ml_desired_count      = 2

db_instance_class = "db.t4g.micro"
db_multi_az       = false
redis_node_type   = "cache.t4g.micro"

active_model_version = "xgboost_v1"
alarm_email          = ""
